{
  "name": "ngx-upgrade-doctor",
  "version": "0.5.1",
  "description": "Scan, fix and plan Angular major-version upgrades one hop at a time (6 -> 22), with dependency advice and an explicit-types pass for v22+.",
  "keywords": [
    "angular",
    "upgrade",
    "migration",
    "ng update",
    "codemod",
    "cli",
    "angular-material",
    "mdc",
    "strict-mode"
  ],
  "license": "MIT",
  "author": "Azaruddin A M (https://github.com/AzaruddinAM)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzaruddinAM/ngx-upgrade-doctor.git"
  },
  "homepage": "https://github.com/AzaruddinAM/ngx-upgrade-doctor#readme",
  "bugs": {
    "url": "https://github.com/AzaruddinAM/ngx-upgrade-doctor/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/AzaruddinAM"
  },
  "bin": {
    "ngx-upgrade-doctor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=14.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "semver": "^7.6.3",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/semver": "^7.5.8"
  }
}
